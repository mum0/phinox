# PHINOX Environment Variables
# Copy to .env and fill in real values.
#
# Per دستور §5 + §7: secrets NEVER committed. .env is gitignored.
# Production secrets come from the deploy host's environment (Hetzner VPS
# .env file or Docker secrets). CI/CD never reads production secrets.

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Cairo
# Production: comma-separated list of allowed hostnames (no wildcards).
# Staging: same format.
# Example: DJANGO_ALLOWED_HOSTS=phinox.example.com,api.phinox.example.com

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://phinox:phinox@localhost:5432/phinox
POSTGRES_PASSWORD=phinox

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS + CSRF (production) ─────────────────────────────────────────────
# Per دستور §5: CORS locked down per-origin in prod. CSRF_TRUSTED_ORIGINS
# must list every domain that serves POST forms.
CORS_ALLOWED_ORIGINS=https://phinox.example.com
CSRF_TRUSTED_ORIGINS=https://phinox.example.com

# ── Email ─────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=PHINOX <no-reply@phinox.example>
DJANGO_SITE_DOMAIN=https://phinox.example
DJANGO_ADMIN_EMAIL=ops@phinox.example

# ── Sentry (production + staging) ─────────────────────────────────────────
# Optional — if empty, Sentry init is a no-op (per config/settings/prod.py).
# Get the DSN from https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=
# Sample rate for performance traces (0.0 = none, 1.0 = all). Per دستور §11
# recommendation: 0.1 for prod, 0.5 for staging.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional: track deploy releases by git SHA (set at deploy time by CI).
SENTRY_RELEASE=

# ── GA4 (optional) ───────────────────────────────────────────────────────
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_DEBUG=False

# ── AWS S3 / Hetzner Object Storage (production media) ───────────────────
# Required for production (media files). Optional for staging (falls back
# to local filesystem if these are empty).
# Hetzner docs: https://docs.hetzner.com/storage/object-storage
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=fsn1

# ── PAYMOB (Fill after Paymob onboarding — see PAYMOB_SETUP.md) ──────────
# Get HMAC Secret from: Paymob Dashboard -> Settings -> Account Info
PAYMOB_HMAC_SECRET=
# Get API Key from: Paymob Dashboard -> Settings -> Account Info
PAYMOB_API_KEY=
# Get Integration ID from: Paymob Dashboard -> Developers -> Payment Integrations
PAYMOB_INTEGRATION_ID=
# Get Iframe ID from: Paymob Dashboard -> Developers -> Iframes
PAYMOB_IFRAME_ID=
# Use True for staging/testing, False for production
PAYMOB_SANDBOX=True
# Webhook URL — must be publicly accessible (use ngrok in dev)
PAYMOB_WEBHOOK_URL=http://localhost:8000/payments/webhooks/paymob/

# ── Cost Control Flags (defaults = $0) ──────────────────────────────────
# All flags default to the zero-cost local option. Change to enable
# paid/cloud alternatives. See docs/DEPLOYMENT_MODES.md for details.
PAYMOB_MODE=simulation
SMS_BACKEND=console
STORAGE_BACKEND=local
CACHE_BACKEND=locmem
ERROR_TRACKING=none
EMAIL_BACKEND_MODE=console
USE_CELERY=False
USE_CLOUD_TASKS=False

# ── Docker / Celery (PHASE-FINAL — entrypoint branching) ───────────────
# docker/entrypoint.sh reads these env vars:
#   CELERY_ROLE   → "worker" | "beat" | "" (default = Django web).
#                   Set by docker-compose.yml's celery_worker/celery_beat
#                   services; leave empty for the web service.
#   RUN_MIGRATIONS → "1" = run ``migrate --noinput`` on container start
#                    (only the ``web`` service does this; workers skip).
#                    "0" = skip migrations (default for workers + beat).
CELERY_ROLE=
RUN_MIGRATIONS=1

# ── Google Cloud Free Tier (opt-in) ─────────────────────────────────────
# Fill these ONLY when upgrading from local to Google Cloud backends.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=

# ── Google OAuth 2.0 (PHINOX-GOOGLE-OAUTH-MANUAL) ─────────────────────
# Used for "Sign in with Google" on login + register pages.
# Get these from Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client ID (type: Web application).
#
# In Google Cloud Console, add the GOOGLE_REDIRECT_URI to the
# "Authorized redirect URIs" list. For local dev, the default is
# http://localhost:8000/accounts/google/callback/ — add it to the Console.
#
# When GOOGLE_CLIENT_ID is empty (default), the Google sign-in button is
# hidden on login/register (per spec — no broken UX).
GOOGLE_CLIENT_ID=
# Per دستور §5: client_secret is sensitive — NEVER commit it to git.
# Add it to .env (which is gitignored) or via the deploy host's env.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/google/callback/
